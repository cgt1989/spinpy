{
  "name": "spinpy",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libgl1 libxrender1 xvfb && pip install --upgrade pip",
  "postCreateCommand": "pip install -e '.[elastico,fem,malla,lote,test,informe]' tifffile ruff",
  "containerEnv": {
    "PYVISTA_OFF_SCREEN": "true",
    "PYTHONUTF8": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter", "charliermarsh.ruff"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests", "-m", "not lento"]
      }
    }
  }
}
